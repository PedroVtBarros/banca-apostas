{
  "name": "banca-apostas",
  "productName": "Gestão de Banca",
  "version": "1.0.0",
  "description": "Gestão de banca de apostas esportivas — aplicativo desktop offline.",
  "author": "Gestão de Banca",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "icon": "node scripts/make-icon.mjs",
    "pack": "npm run build && electron-builder --dir --win --x64",
    "dist": "npm run build && electron-builder --win --x64",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
